% layout 'default';
% title 'Checkout';
% my $items = stash('items') // [];
% my $total = stash('total') // 0;
% my $user = stash('user') // {};

<div class="container" style="margin: 60px auto;">
    <h1>Checkout</h1>

    <table style="margin-top: 20px;">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            % foreach my $item (@$items) {
                <tr>
                    <td><%= $item->{name} %></td>
                    <td><%= $c->display_money($item->{price}) %></td>
                    <td><%= $item->{quantity} %></td>
                    <td><%= $c->display_money($item->{subtotal}) %></td>
                </tr>
            % }
        </tbody>
    </table>

    <h3 style="text-align: right; margin-top: 15px;">Order Total: <%= $c->display_money($total) %></h3>

    <form method="POST" action="/checkout" style="margin-top: 25px;">
        <div class="form-group">
            <label for="shipping_name">Full Name</label>
            <input type="text" id="shipping_name" name="shipping_name" value="<%= $user->{full_name} // '' %>" required>
        </div>
        <div class="form-group">
            <label for="shipping_phone">Phone Number</label>
            <input type="text" id="shipping_phone" name="shipping_phone" value="<%= $user->{phone} // '' %>" required>
        </div>
        <div class="form-group">
            <label for="shipping_address">Address</label>
            <textarea id="shipping_address" name="shipping_address" required></textarea>
        </div>
        <div class="form-group">
            <label for="shipping_city">City</label>
            <input type="text" id="shipping_city" name="shipping_city" value="<%= $user->{city} // '' %>" required>
        </div>
        <div class="form-group">
            <label for="shipping_postal_code">Postal Code</label>
            <input type="text" id="shipping_postal_code" name="shipping_postal_code" value="<%= $user->{postal_code} // '' %>" required>
        </div>
        <div class="form-group">
            <label for="shipping_country">Country</label>
            <input type="text" id="shipping_country" name="shipping_country" value="India" required>
        </div>
        <button type="submit" class="btn btn-primary">Continue to Payment</button>
        <a href="/cart" class="btn btn-info">Back to Cart</a>
    </form>
</div>
