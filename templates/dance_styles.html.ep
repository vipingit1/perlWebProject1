% layout 'default';
% title $section_name;
% my $styles = stash('styles') // [];

<div class="container" style="margin: 60px auto;">
    <h1><%= $section_name %></h1>
    <p style="margin-top: 12px;"><%= $section_description %></p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 30px;">
        % foreach my $style (@$styles) {
            <a href="/shop/vgag-partner-dance-studio-all-styles/<%= $style->{slug} %>" class="btn btn-primary" style="text-align: center; padding: 20px;">
                <%= $style->{name} %>
            </a>
        % }
    </div>

    <div style="margin-top: 30px;">
        <a href="/shop" class="btn btn-info">Back to Lines Of Businesses</a>
    </div>
</div>
