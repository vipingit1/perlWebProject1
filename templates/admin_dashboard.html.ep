% layout 'default';
% title 'Admin Dashboard';

<div class="container" style="margin: 60px auto;">
    <h1>Admin Dashboard</h1>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin-top: 25px;">
        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 20px;">
            <h3>Products</h3>
            <p style="font-size: 1.8em; color: #667eea;"><%= $products // 0 %></p>
        </div>
        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 20px;">
            <h3>Orders</h3>
            <p style="font-size: 1.8em; color: #667eea;"><%= $orders // 0 %></p>
        </div>
        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 20px;">
            <h3>Paid Orders</h3>
            <p style="font-size: 1.8em; color: #667eea;"><%= $paid_orders // 0 %></p>
        </div>
        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 20px;">
            <h3>Users</h3>
            <p style="font-size: 1.8em; color: #667eea;"><%= $users // 0 %></p>
        </div>
    </div>

    <div style="margin-top: 30px;">
        <a href="/admin/products" class="btn btn-primary">Manage Products</a>
        <a href="/admin/orders" class="btn btn-info">Manage Orders</a>
        <a href="/admin/partner-uploads" class="btn btn-success">Partner Uploads</a>
        <a href="/admin/reports" class="btn btn-primary">GST & Sales Reports</a>
        <a href="/admin/reels" class="btn btn-info">Meta Reels Automation</a>
        <a href="/admin/shiprocket" class="btn btn-success">Shiprocket Shipping</a>
        <a href="/admin/otp-settings" class="btn btn-primary">OTP & SMS Settings</a>
        <a href="/admin/slack" class="btn btn-info">Manage Slack Connect</a>
        <a href="/admin/users" class="btn btn-primary">Manage Users & Access</a>
    </div>
</div>
