% layout 'default';
% title 'Order Details';

<div class="container" style="margin: 60px auto;">
    <h1>Order #<%= $order->{id} %></h1>
    <p style="margin-top: 10px;">Status: <strong><%= $order->{status} %></strong></p>
    <p>Payment Status: <strong><%= $order->{payment_status} // 'pending' %></strong></p>
    <p>Total: <strong><%= $c->format_money($order->{total_price}, $order->{currency}) %></strong></p>
    <p>Payment Method: <%= $order->{payment_method} // 'N/A' %></p>
    <p>Payment Reference: <%= $order->{payment_reference} // 'N/A' %></p>
    <p>Tracking Number: <strong><%= $order->{tracking_number} // 'N/A' %></strong></p>
    % if ($order->{tracking_number}) {
        <p><a href="/order/<%= $order->{id} %>/track" class="btn btn-success btn-sm">Track Shipment</a></p>
    % }
    <p><a href="/invoice/<%= $order->{id} %>" class="btn btn-info btn-sm">View Invoice</a></p>
    <p>Email Confirmation: <%= $order->{confirmation_email_status} // 'pending' %></p>
    <p>Shipping To: <strong><%= $order->{shipping_name} // 'N/A' %></strong> (<%= $order->{shipping_phone} // 'N/A' %>)</p>
    <p>Shipping Address: <%= $order->{shipping_address} // 'N/A' %>, <%= $order->{shipping_city} // '' %> <%= $order->{shipping_postal_code} // '' %>, <%= $order->{shipping_country} // '' %></p>

    <h2 style="margin-top: 30px;">Items</h2>
    <table style="margin-top: 15px;">
        <thead>
            <tr>
                <th>Product</th>
                <th>HSN</th>
                <th>GST %</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Taxable</th>
                <th>GST</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            % foreach my $item (@$items) {
                <tr>
                    <td><%= $item->{name} %></td>
                    <td><%= $item->{hsn_code} // '0000' %></td>
                    <td><%= sprintf('%.2f', ($item->{gst_rate} // 0)) %></td>
                    <td><%= $c->format_money($item->{price}, $order->{currency}) %></td>
                    <td><%= $item->{quantity} %></td>
                    <td><%= $c->format_money(($item->{taxable_amount} // ($item->{price} * $item->{quantity})), $order->{currency}) %></td>
                    <td><%= $c->format_money(($item->{tax_amount} // 0), $order->{currency}) %></td>
                    <td><%= $c->format_money(($item->{line_total} // ($item->{price} * $item->{quantity})), $order->{currency}) %></td>
                </tr>
            % }
        </tbody>
    </table>

    <a href="/products" class="btn btn-primary" style="margin-top: 20px;">Continue Shopping</a>
</div>
