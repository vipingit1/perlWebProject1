% layout 'default';
% title 'Product Details';

<div class="container" style="margin: 60px auto;">
    % if (!$product) {
        <h1>Product not found</h1>
        <p>The requested product does not exist.</p>
        <a href="/products" class="btn btn-primary">Back to Products</a>
    % } else {
        <h1><%= $product->{name} %></h1>
        <div style="width: 100%; max-width: 420px; height: 320px; background: #f5f5f5; display: flex; align-items: center; justify-content: center; margin: 20px 0; border-radius: 8px;">
            <img src="<%= $product->{image_url} // '/images/placeholder.png' %>" alt="<%= $product->{name} %>" style="max-width: 100%; max-height: 100%;">
        </div>
        <p style="color: #999; margin-top: 5px;"><%= $product->{category} // 'General' %></p>
        <p style="margin: 20px 0;"><%= $product->{description} // 'No description available.' %></p>
        <p style="font-size: 1.4em; font-weight: bold; color: #667eea;"><%= $c->display_money($product->{price} // 0) %></p>
        <p style="margin-top: 10px;">Stock: <strong><%= $product->{stock} // 0 %></strong></p>

        <form method="POST" action="/cart/add" style="margin-top: 25px;">
            <input type="hidden" name="product_id" value="<%= $product->{id} %>">
            <div class="form-group">
                <label for="quantity">Quantity</label>
                <input type="number" id="quantity" name="quantity" min="1" value="1" required>
            </div>
            <button type="submit" class="btn btn-primary">Add to Cart</button>
            <a href="/products" class="btn btn-info">Back</a>
        </form>
    % }
</div>
