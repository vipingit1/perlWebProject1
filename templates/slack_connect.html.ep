% layout 'default';
% title 'Slack Connect';
% my $user = stash('user') // {};
% my $config = stash('config') // {};
% my $requests = stash('requests') // [];

<div class="container" style="margin: 60px auto; max-width: 1100px;">
    <h1>Slack Connect</h1>
    <p style="margin-top: 12px;"><%= $config->{help_text} %></p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 28px;">
        <div style="background: linear-gradient(135deg, #4a154b, #611f69); color: #fff; border-radius: 12px; padding: 24px;">
            <div style="font-size: 0.9rem; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.08em;">Slack Plugin</div>
            <h2 style="margin-top: 10px; color: #fff;"><%= $config->{workspace_name} %></h2>
            <p style="margin-top: 12px; color: rgba(255,255,255,0.9);">
                Logged-in users can open the workspace, install Slack, and request channel access from one place.
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px;">
                <a href="<%= $config->{workspace_url} %>" class="btn" style="background: #36c5f0; color: #111;">Open Slack Web</a>
                <a href="<%= $config->{download_url} %>" class="btn" style="background: #2eb67d; color: #fff;">Download Slack</a>
                % if ($config->{invite_url}) {
                    <a href="<%= $config->{invite_url} %>" class="btn" style="background: #ecb22e; color: #111;">Join Workspace</a>
                % }
                % if ($config->{channel_url}) {
                    <a href="<%= $config->{channel_url} %>" class="btn" style="background: #fff; color: #4a154b;">Open <%= $config->{channel_name} || 'Channel' %></a>
                % }
            </div>
        </div>

        <div style="border: 1px solid #ddd; border-radius: 12px; padding: 24px; background: #fff;">
            <h2 style="margin-bottom: 12px;">Connection Checklist</h2>
            <ol style="padding-left: 20px; color: #444;">
                <li>Open the VGAG Slack workspace.</li>
                <li>Install Slack if it is not already available.</li>
                <li>Use the form below to request invite or channel access.</li>
                <li>Track your latest request status on this page.</li>
            </ol>
            <p style="margin-top: 16px; color: #666;">
                Preferred channel: <strong><%= $config->{channel_name} || '#general' %></strong>
            </p>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr); gap: 24px; margin-top: 30px;">
        <div style="border: 1px solid #ddd; border-radius: 12px; padding: 24px; background: #fff;">
            <h2>Request Slack Access</h2>
            <form method="POST" action="/slack/connect" style="max-width: none; margin-top: 18px;">
                <div style="display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 16px;">
                    <div class="form-group">
                        <label for="full_name">Full Name</label>
                        <input id="full_name" name="full_name" type="text" required value="<%= $user->{full_name} || $user->{username} || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input id="email" name="email" type="email" required value="<%= $user->{email} || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone</label>
                        <input id="phone" name="phone" type="text" value="<%= $user->{phone} || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="slack_email">Slack Email</label>
                        <input id="slack_email" name="slack_email" type="email" placeholder="Email to receive Slack invite">
                    </div>
                    <div class="form-group">
                        <label for="team_role">Team / Role</label>
                        <input id="team_role" name="team_role" type="text" placeholder="Marketing, Support, Operations">
                    </div>
                    <div class="form-group">
                        <label for="preferred_channel">Preferred Channel</label>
                        <input id="preferred_channel" name="preferred_channel" type="text" placeholder="<%= $config->{channel_name} || '#general' %>">
                    </div>
                </div>

                <div class="form-group">
                    <label for="notes">Connection Notes</label>
                    <textarea id="notes" name="notes" required placeholder="Mention what you need access to, your use case, and any channels or workflows you should join."></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Submit Slack Request</button>
            </form>
        </div>

        <div style="border: 1px solid #ddd; border-radius: 12px; padding: 24px; background: #fff;">
            <h2>Recent Requests</h2>
            % if (@$requests) {
                <div style="display: grid; gap: 14px; margin-top: 16px;">
                    % for my $request (@$requests) {
                        <div style="border: 1px solid #eee; border-radius: 8px; padding: 14px; background: #fafafa;">
                            <div style="display: flex; justify-content: space-between; gap: 10px; align-items: center;">
                                <strong><%= ucfirst $request->{status} %></strong>
                                <span style="color: #666; font-size: 0.9rem;"><%= $request->{created_at} %></span>
                            </div>
                            <div style="margin-top: 8px; color: #444;"><%= $request->{preferred_channel} || ($config->{channel_name} || '#general') %></div>
                            % if ($request->{notes}) {
                                <p style="margin-top: 8px; color: #666;"><%= $request->{notes} %></p>
                            % }
                        </div>
                    % }
                </div>
            % } else {
                <p style="margin-top: 16px; color: #666;">No Slack requests submitted yet.</p>
            % }
        </div>
    </div>
</div>
