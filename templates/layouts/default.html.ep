<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - VGAG BUSINESS SUITE</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Navigation */
        nav {
            background-color: #333;
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            transition: color 0.3s;
        }

        nav a:hover {
            color: #667eea;
        }

        .nav-item {
            position: relative;
            display: inline-block;
        }

        .submenu {
            display: none;
            position: absolute;
            top: 30px;
            left: 0;
            min-width: 240px;
            background: #222;
            border: 1px solid #444;
            border-radius: 6px;
            padding: 10px 0;
            z-index: 200;
        }

        .submenu a {
            display: block;
            margin: 0;
            padding: 8px 14px;
            color: #fff;
        }

        .submenu a:hover {
            background: #333;
            color: #667eea;
        }

        .submenu-heading {
            display: block;
            margin: 6px 0 2px;
            padding: 8px 14px;
            color: #fbbf24;
            font-weight: 600;
            border-top: 1px solid #3a3a3a;
        }

        .submenu-child {
            padding-left: 14px !important;
            padding-right: 14px !important;
            text-align: right;
            font-size: 0.95em;
            color: #7dd3fc !important;
            background: #1b2a3a;
            border-left: 3px solid #38bdf8;
            border-radius: 4px;
            margin: 2px 8px;
            font-weight: 600;
        }

        .submenu-child::before {
            content: "➜ ";
            color: #facc15;
            font-weight: 700;
        }

        .submenu-child:hover {
            background: #24384f !important;
            color: #fde68a !important;
        }

        .nav-item:hover .submenu {
            display: block;
        }

        .logo {
            font-size: 1.5em;
            font-weight: bold;
            color: #667eea;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        /* Buttons */
        .btn {
            display: inline-block;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            font-size: 1em;
            transition: background-color 0.3s;
        }

        .btn-primary {
            background-color: #667eea;
            color: white;
        }

        .btn-primary:hover {
            background-color: #5568d3;
        }

        .btn-info {
            background-color: #17a2b8;
            color: white;
            padding: 5px 10px;
            font-size: 0.9em;
        }

        .btn-info:hover {
            background-color: #138496;
        }

        .btn-danger {
            background-color: #dc3545;
            color: white;
        }

        .btn-danger:hover {
            background-color: #c82333;
        }

        .btn-lg {
            padding: 15px 30px;
            font-size: 1.1em;
        }

        .btn-sm {
            padding: 5px 10px;
            font-size: 0.85em;
        }

        /* Forms */
        form {
            max-width: 500px;
            margin: 0 auto;
            padding: 20px;
            background: #f9f9f9;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
        }

        input, textarea, select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 1em;
            font-family: inherit;
        }

        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 5px rgba(102, 126, 234, 0.3);
        }

        textarea {
            min-height: 100px;
            resize: vertical;
        }

        /* Alerts */
        .alert {
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .alert-error {
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            color: #721c24;
        }

        .alert-success {
            background-color: #d4edda;
            border: 1px solid #c3e6cb;
            color: #155724;
        }

        /* Footer */
        footer {
            background-color: #f9f9f9;
            border-top: 1px solid #ddd;
            padding: 40px 20px;
            margin-top: 60px;
        }

        footer .container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
        }

        footer h4 {
            margin-bottom: 15px;
        }

        footer a {
            display: block;
            color: #666;
            text-decoration: none;
            margin-bottom: 8px;
            transition: color 0.3s;
        }

        footer a:hover {
            color: #333;
        }

        footer .footer-bottom {
            text-align: center;
            padding-top: 20px;
            margin-top: 20px;
            border-top: 1px solid #ddd;
            color: #666;
        }

        /* Tables */
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: #f5f5f5;
            font-weight: 600;
        }

        tr:hover {
            background-color: #f9f9f9;
        }
    </style>
</head>
<body>
    % my $lang = $c->current_language;
    % my $currency = $c->current_currency;
    % my $current_path = $c->req->url->path->to_string;
    % my $session_user = $c->get_session_user;
    % my $can_access_admin = $session_user && $c->has_access($session_user, qw(admin manager editor support));
    <!-- Navigation -->
    <nav>
        <div class="container">
            <div class="logo">🛒 VGAG BUSINESS SUITE</div>
            <div class="nav-right">
                <a href="/"><%= $c->t('home') %></a>
                <a href="/products"><%= $c->t('products') %></a>
                <div class="nav-item">
                    <a href="/shop/business-partners">Business Partners</a>
                    <div class="submenu">
                        <a class="submenu-child" href="/shop/sree-physio-therapists">Sree Physio Therapists</a>
                        <a class="submenu-child" href="/shop/sree-physio-therapists/website-demo">Website Demo</a>
                        <a class="submenu-child" href="/shop/sree-physio-therapists/brand-assets">Brand Assets</a>
                        <a class="submenu-child" href="/shop/sree-physio-therapists/testimonials">Testimonials</a>
                        <a class="submenu-child" href="/shop/sree-physio-therapists/products">Products</a>
                        <a class="submenu-child" href="/shop/sree-physio-therapists/team">Team</a>
                        <a class="submenu-child" href="/shop/sree-physio-therapists/social-media-links">Social Media Links</a>
                        <a class="submenu-child" href="/shop/sree-physio-therapists/agreements">Agreements</a>
                        <a class="submenu-child" href="/shop/sree-physio-therapists/golive-date">GoLive Date</a>
                        <a class="submenu-child" href="/shop/sree-physio-therapists/open-issues">Open Issues</a>
                        <a class="submenu-child" href="/shop/sree-physio-therapists/workflow">Workflow</a>
                    </div>
                </div>
                <a href="/shop/vendors">Vendors</a>
                <a href="/shop/suppliers">Suppliers</a>
                <a href="/shop/auditors">Auditors</a>
                <a href="/shop/news">News</a>
                <a href="/shop/affiliates">Affiliates</a>
                <a href="/shop/franchise">Franchise</a>
                <div class="nav-item">
                    <a href="/about">Info</a>
                    <div class="submenu">
                        <a href="/about">About</a>
                        <a href="/shipping">Shipping Info</a>
                        <a href="/returns">Returns</a>
                        <a href="/faq">FAQ</a>
                        <a href="/contact">Contact</a>
                    </div>
                </div>
                <div class="nav-item">
                    <a href="/shop">Lines Of Businesses</a>
                    <div class="submenu">
                        <a href="/shop/padma-impex">PADMA IMPEX</a>
                        <a href="/shop/vgag-business-solutions">VGAG BUSINESS SOLUTIONS</a>
                        <a href="/shop/efbiwff-ngo-section8">EFBIWFF (NGO/SECTION8)</a>
                        <a href="/shop/vgag-partner-dance-studio-all-styles">VGAG PARTNER DANCE STUDIO ALL STYLES</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/salsa">SALSA</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/salsa-rueda">SALSA RUEDA</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/casino-rueda">CASINO RUEDA</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/bachata">BACHATA</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/cumbia">CUMBIA</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/nortenos">NORTENOS</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/tango">TANGO</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/jive">JIVE</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/merengue">MERENGUE</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/rumba">RUMBA</a>
                        <a class="submenu-child" href="/shop/vgag-partner-dance-studio-all-styles/chacha">CHACHA</a>
                        <a href="/shop/vgag-fresh-meals-prep-kit-delivery">VGAG Fresh Meals Prep Kit Delivery</a>
                        <a href="/shop/vgag-bike-rentals-airport-shuttles">VGAG Bike Rentals and Airport Shuttles</a>
                        <a href="/shop/vgag-luxury-homestays">VGAG Luxury Homestays</a>
                        <a href="/shop/vgag-expats-network">VGAG Expats Network</a>
                    </div>
                </div>
                % if (session('user_id')) {
                    <a href="/cart"><%= $c->t('cart') %></a>
                    % if ($can_access_admin) {
                        <a href="/admin">Admin</a>
                    % }
                    <a href="/logout"><%= $c->t('logout') %></a>
                % } else {
                    <a href="/login"><%= $c->t('login') %></a>
                    <a href="/register"><%= $c->t('register') %></a>
                % }
                <form method="POST" action="/preferences" style="display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 8px; background: transparent; border: 0; max-width: none;">
                    <input type="hidden" name="return_to" value="<%= $current_path %>">
                    <label for="lang-select" style="color: #fff; margin: 0;"><%= $c->t('language') %></label>
                    <select id="lang-select" name="lang" onchange="this.form.submit()" style="width: auto; padding: 6px;">
                        % for my $lang_code (sort keys %{$c->languages}) {
                            <option value="<%= $lang_code %>" <%= $lang_code eq $lang ? 'selected' : '' %>><%= $c->languages->{$lang_code} %></option>
                        % }
                    </select>
                    <label for="currency-select" style="color: #fff; margin: 0;"><%= $c->t('currency') %></label>
                    <select id="currency-select" name="currency" onchange="this.form.submit()" style="width: auto; padding: 6px;">
                        % for my $currency_code (sort keys %{$c->currencies}) {
                            <option value="<%= $currency_code %>" <%= $currency_code eq $currency ? 'selected' : '' %>><%= $currency_code %></option>
                        % }
                    </select>
                </form>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        % if (my $error = flash('error')) {
            <div class="container">
                <div class="alert alert-error"><%= $error %></div>
            </div>
        % }
        % if (my $success = flash('success')) {
            <div class="container">
                <div class="alert alert-success"><%= $success %></div>
            </div>
        % }
        <%= content %>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div>
                <h4>About Us</h4>
                <p>Your trusted online shopping destination for quality products at great prices.</p>
            </div>
            <div>
                <h4>Quick Links</h4>
                <a href="/products">Products</a>
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
                <a href="/privacy-policy">Privacy Policy</a>
                <a href="/terms-of-service">Terms of Service</a>
            </div>
            <div>
                <h4>Customer Service</h4>
                <a href="/faq">FAQ</a>
                <a href="/shipping">Shipping Info</a>
                <a href="/returns">Returns</a>
            </div>
            <div>
                <h4>Contact</h4>
                <p>Email: support@vgagbusinesssuite.com</p>
                <p>Phone: 1-800-VGAG-SUITE</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2024 VGAG BUSINESS SUITE. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
